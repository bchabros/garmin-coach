#!/bin/sh
# Generated for one immutable release/architecture; no developer tools are required.
set -eu
if [ "$(uname -s)" != Darwin ] || [ "$(uname -m)" != '@@ARCH@@' ]; then
  echo 'This installer requires macOS @@ARCH@@. Choose the matching release asset.' >&2
  exit 2
fi
if [ "$(sysctl -in sysctl.proc_translated 2>/dev/null || true)" = 1 ]; then
  echo 'Rosetta Terminal detected. Open a native Apple Silicon Terminal and run install-arm64.sh.' >&2
  exit 2
fi
case "$(sw_vers -productVersion)" in
  1[0-4].*) echo 'This release requires macOS 15 or newer.' >&2; exit 2 ;;
esac
prepare_only=false
for option in "$@"; do
  if [ "$option" = --prepare-only ]; then prepare_only=true; fi
done
if [ "$prepare_only" = false ] && [ ! -t 0 ] && [ ! -r /dev/tty ]; then
  echo 'Run setup from an interactive Terminal for account login and setup choices.' >&2
  exit 2
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/garmin-coach-bootstrap.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
fetch() {
  if [ -n "${GARMIN_COACH_ASSET_CACHE:-}" ] && [ -f "$GARMIN_COACH_ASSET_CACHE/$4" ]; then
    cp "$GARMIN_COACH_ASSET_CACHE/$4" "$2"
  else
    /usr/bin/curl --proto '=https' --tlsv1.2 -fsSL "$1" -o "$2"
  fi
  printf '%s  %s\n' "$3" "$2" | /usr/bin/shasum -a 256 -c - >/dev/null
}
fetch '@@PYTHON_URL@@' "$work/python.tar.gz" '@@PYTHON_SHA@@' python.tar.gz
fetch '@@BUNDLE_URL@@' "$work/bundle.tar.gz" '@@BUNDLE_SHA@@' bundle.tar.gz
fetch '@@MANIFEST_URL@@' "$work/manifest.json" '@@MANIFEST_SHA@@' manifest.json
mkdir "$work/runtime" "$work/bundle"
/usr/bin/tar -xzf "$work/python.tar.gz" -C "$work/runtime"
/usr/bin/tar -xzf "$work/bundle.tar.gz" -C "$work/bundle"
# Pin the bootstrap interpreter, and keep prompts connected to the user's terminal.
if [ "$prepare_only" = true ]; then
  "$work/runtime/python/bin/python3" -I "$work/bundle/bootstrap.py" install --manifest "$work/manifest.json" "$@"
else
  "$work/runtime/python/bin/python3" -I "$work/bundle/bootstrap.py" install --manifest "$work/manifest.json" "$@" </dev/tty
fi
