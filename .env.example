# New athlete: run `garmin-coach --home <empty-folder> setup` instead of copying
# this compatibility example. It asks for your own history start and weekly template.
# Existing/manual installation: copy this file to .env (gitignored): a .env marks
# a folder as the athlete installation a run acts on (ADR 0031). Every value below is
# optional and shows the default; relative paths resolve against the installation.

# Credentials are prompted interactively on the first login; OAuth tokens are
# then cached in GARMINTOKENS and refreshed automatically, so later runs never
# ask again. Set these only for a non-interactive first run.
# GARMIN_EMAIL=you@example.com
# GARMIN_PASSWORD=

# Backfill start (this account has real data from 2026-06-08; earlier is onboarding).
# DATA_START_DATE=2026-06-08

# An explicit first-run weekly choice: seven comma-separated intents (Mon-Sun),
# or 'none'. Applied only when creating a database; existing DB plans are preserved.
# WEEKLY_TEMPLATE=none

# SQLite system-of-record.
# DB_PATH=./data/garmin.db

# Where garminconnect caches OAuth tokens (mode 0600). Inside the installation by
# default, so two installations never share a Garmin login.
# GARMINTOKENS=.garminconnect

# Re-check window: the trailing days, ending yesterday, that every sync pulls again
# so a run uploaded from the watch late still lands (ADR 0026). 1 = no re-check.
# SYNC_RECHECK_DAYS=3

# Nightly-run logging.
# LOG_PATH=./logs/daily.log
# LOG_MAX_BYTES=1000000
# LOG_BACKUP_COUNT=5
