# Everything here is OPTIONAL — the values below are the defaults the code uses.
# Copy to .env (gitignored) only when you want to override something.

# Credentials are prompted interactively on the first login; OAuth tokens are
# then cached in GARMINTOKENS and refreshed automatically, so later runs never
# ask again. Set these only for a non-interactive first run.
# GARMIN_EMAIL=you@example.com
# GARMIN_PASSWORD=

# Backfill start (this account has real data from 2026-06-08; earlier is onboarding).
# DATA_START_DATE=2026-06-08

# SQLite system-of-record.
# DB_PATH=./data/garmin.db

# Where garminconnect caches OAuth tokens (mode 0600).
# GARMINTOKENS=~/.garminconnect

# Nightly-run logging.
# LOG_PATH=./logs/daily.log
# LOG_MAX_BYTES=1000000
# LOG_BACKUP_COUNT=5
