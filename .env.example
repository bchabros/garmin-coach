# Garmin Connect credentials. Copy to .env (gitignored) and fill in.
# Password is OPTIONAL: after the first login, tokens are cached in GARMINTOKENS
# and refreshed automatically, so you can remove it afterwards.
GARMIN_EMAIL=you@example.com
# GARMIN_PASSWORD=

# Backfill start (this account has real data from 2026-06-08; earlier is onboarding).
DATA_START_DATE=2026-06-08

# SQLite system-of-record.
DB_PATH=./data/garmin.db

# Where garminconnect caches OAuth tokens (mode 0600).
GARMINTOKENS=~/.garminconnect
